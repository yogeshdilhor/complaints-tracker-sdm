DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-dev-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://sdm:sdm@127.0.0.1:5433/sdm
MEDIA_ROOT=./media
ADMIN_URL=admin/

# Optional AI reading of typed letters. All calls use OpenAI gpt-6-luna. Empty key = feature off.
OPENAI_API_KEY=
VISION_MAX_PAGES=6
LEGACY_MAX_MB=150
LEGACY_MAX_PAGES=150
OPENAI_REASONING_EFFORT=
