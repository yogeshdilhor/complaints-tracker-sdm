DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-dev-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://sdm:sdm@127.0.0.1:5433/sdm
MEDIA_ROOT=./media
ADMIN_URL=admin/

# Optional AI reading of typed letters. LLM_PROVIDER: openai or sarvam. Empty key = feature off.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-4.1-mini
VISION_MAX_PAGES=6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LEGACY_MAX_MB=150
LEGACY_MAX_PAGES=150
OPENAI_REASONING_EFFORT=
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_REASONING_EFFORT=off
